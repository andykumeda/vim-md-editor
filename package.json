{
  "name": "vimdown",
  "productName": "VimDown",
  "version": "1.0.8",
  "description": "A Vim-keybinding markdown editor with split-pane preview",
  "author": "andy@kumeda.com",
  "type": "module",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build:web": "vite build",
    "build": "tsx script/build.ts && npm run electron:build && npm run install:mac",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "install:mac": "tsx script/install-macos-app.ts",
    "signing:setup": "bash script/create-macos-signing-identity.sh",
    "release:mac": "tsx script/build-macos-release.ts",
    "test:updater": "node --test electron/updater-process.test.cjs",
    "electron:dev": "concurrently \"vite --config vite.config.ts\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "electron:build:x64": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64",
    "electron:build:universal": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --universal"
  },
  "build": {
    "appId": "com.kumeda.vimdown",
    "productName": "VimDown",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "afterPack": "script/sign-macos-app.cjs",
    "files": [
      "electron/**/*",
      "dist/public/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "SUFeedURL": "https://raw.githubusercontent.com/andykumeda/vim-md-editor/main/docs/appcast.xml",
        "SUPublicEDKey": "l/SNkU3yHLO0zYGfUf9+CPhK4n7+RO0G8DL/pq5EXGI=",
        "SUEnableAutomaticChecks": true,
        "SUScheduledCheckInterval": 86400,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown File",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": [
              "net.daringfireball.markdown"
            ],
            "LSHandlerRank": "Owner",
            "CFBundleTypeExtensions": [
              "md",
              "markdown",
              "mdown",
              "mkd",
              "txt"
            ]
          },
          {
            "CFBundleTypeName": "Convertible Document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeExtensions": [
              "pdf",
              "docx",
              "doc",
              "pptx",
              "ppt",
              "xlsx",
              "xls",
              "html",
              "htm",
              "csv",
              "xml",
              "json",
              "epub",
              "png",
              "jpg",
              "jpeg",
              "tiff",
              "bmp",
              "mp3",
              "wav",
              "m4a",
              "flac",
              "ogg",
              "zip"
            ]
          }
        ],
        "NSDocumentsFolderUsageDescription": "VimDown needs access to open and save markdown files.",
        "NSDesktopFolderUsageDescription": "VimDown needs access to open and save markdown files.",
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown File",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "md",
                "markdown",
                "mdown",
                "mkd"
              ],
              "public.mime-type": "text/markdown"
            }
          }
        ]
      }
    },
    "dmg": {
      "title": "VimDown ${version}",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown File",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "isPackage": false,
        "rank": "Owner"
      },
      {
        "ext": [
          "pdf",
          "docx",
          "doc",
          "pptx",
          "ppt",
          "xlsx",
          "xls",
          "html",
          "htm",
          "csv",
          "xml",
          "json",
          "epub"
        ],
        "name": "Convertible Document",
        "description": "Document VimDown can convert to Markdown",
        "role": "Viewer",
        "isPackage": false,
        "rank": "Alternate"
      }
    ]
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-query": "^5.60.5",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.0.1",
    "express-session": "^1.18.1",
    "framer-motion": "^11.13.1",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "marked": "^17.0.4",
    "memorystore": "^1.6.7",
    "next-themes": "^0.4.6",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.18",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "20.19.27",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "electron": "^41.1.1",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "5.6.3",
    "vite": "^7.3.0",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "drizzle-kit": {
      "@esbuild-kit/esm-loader": "npm:tsx@^4.23.1"
    }
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
